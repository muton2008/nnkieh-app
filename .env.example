# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ── Firebase Admin (Server-side) ──
# 將 Service Account JSON 壓縮為單行字串
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── JWT ──
JWT_SECRET=your-256-bit-secret

# ── 交通資料開放平台 (TDX) ──
TDX_client_id=your-client-id
TDX_client_secret=your-client-secret

# ── 應用程式 URL ──
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://your-domain.vercel.app

# ── Play Store 審核模式（上架審核通過後請移除）──
REVIEW_MODE=true
REVIEW_MODE_ALLOW_PRODUCTION=true